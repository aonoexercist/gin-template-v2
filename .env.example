# Copy to .env — never commit the real file.
# Keep comments on their own lines: `make` and compose would otherwise
# treat trailing comments as part of the value.

# --- App ---
# development | production | test
APP_ENV=development
HTTP_PORT=8080
# debug | info | warn | error
LOG_LEVEL=debug
# text | json (default: text in development, json otherwise)
LOG_FORMAT=text
# comma separated; "*" allows any; empty = same-origin only
CORS_ALLOWED_ORIGINS=http://localhost:3000
# comma separated CIDRs of reverse proxies whose X-Forwarded-For is trusted
TRUSTED_PROXIES=

# --- Database container (compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DB_PORT=5432

# --- Database (app and goose when running on your host) ---
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
